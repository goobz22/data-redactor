{
  "name": "data-redactor",
  "version": "1.1.0",
  "description": "PII detection and redaction powered by Microsoft Presidio NLP",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run dev.ts",
    "dev:ui": "bun --hot packages/ui/index.html",
    "dev:api": "bun --hot packages/api/server.ts",
    "start": "bun run build:ui && bun packages/api/server.ts",
    "presidio": "presidio-backend/Scripts/python.exe presidio-backend/presidio_server.py",
    "build": "bun run build:ui",
    "build:ui": "bun build-ui.js",
    "test": "bun test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"packages/**/*.{ts,js,json,css,md}\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/goobz22/data-redactor.git"
  },
  "bugs": {
    "url": "https://github.com/goobz22/data-redactor/issues"
  },
  "homepage": "https://github.com/goobz22/data-redactor#readme",
  "author": "Matthew Goluba <mkgoluba@outlook.com> (https://github.com/goobz22)",
  "license": "MIT",
  "keywords": ["redaction", "data-privacy", "pii", "security", "anonymization", "ai-safety", "presidio", "nlp"],
  "dependencies": {
    "mongodb": "^7"
  },
  "devDependencies": {
    "@types/bun": "^1",
    "bun-types": "^1",
    "eslint": "^9",
    "prettier": "^3",
    "typescript": "^5"
  }
}
